{
  "name": "mens-style-guide",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "衣架笔记：写给 181cm / 72kg、偏黄肤色的男生穿搭课。",
  "scripts": {
    "svgs": "node scripts/generate-svgs.mjs",
    "check": "node scripts/check.mjs",
    "build": "node scripts/prepare-photos.mjs && node scripts/generate-svgs.mjs && eleventy",
    "dev": "node scripts/prepare-photos.mjs && PATH_PREFIX= eleventy --serve --port=8080",
    "import-outfit": "node scripts/import-outfit.mjs",
