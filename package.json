  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@11ty/eleventy": "^3.1.8",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2"
  }
}
